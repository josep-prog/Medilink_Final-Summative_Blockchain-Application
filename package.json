{
  "name": "medilink",
  "version": "1.0.0",
  "description": "MediLink: hospital appointment booking with rules enforced on Ethereum",
  "private": true,
  "scripts": {
    "chain": "hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "interact:sepolia": "hardhat run scripts/interact.js --network sepolia",
    "start": "node server/index.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "dotenv": "^18.0.10",
    "hardhat": "^2.29.2"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
